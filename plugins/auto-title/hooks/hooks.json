{
  "description": "会话自动命名：UserPromptSubmit 时（模型开始干活之前）派发后台命名，会话列表立刻有名字",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python3",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/auto_title.py"
            ],
            "timeoutMs": 10000,
            "statusMessage": "Naming session"
          }
        ]
      }
    ]
  }
}
